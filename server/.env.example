# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vault?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=vault_super_secret_jwt_key_production_2026
JWT_EXPIRY=7d

# Groq Cloud API for AI Chatbot
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Server Configuration
PORT=4000
NODE_ENV=development

# Client Origin for CORS (Vercel domain in production, localhost in development)
CLIENT_URL=http://localhost:5173

# Render Free Tier Keep-Alive Trigger (Self-ping every 10 mins)
KEEP_ALIVE=true
RENDER_EXTERNAL_URL=https://your-api.onrender.com
