# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vault?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=vault_super_secret_jwt_key_production_2026
JWT_EXPIRY=7d

# Groq Cloud API for AI Chatbot
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Server Configuration
PORT=4000
NODE_ENV=development

# Client Origin for CORS (Vercel domain in production, localhost in development)
CLIENT_URL=http://localhost:5173

# Render Free Tier Keep-Alive Trigger (Self-ping every 10 mins)
KEEP_ALIVE=true
RENDER_EXTERNAL_URL=https://your-api.onrender.com

# Resend Customer Email & Alert Communication
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Vault <onboarding@resend.dev>

# Firebase project used to verify Google sign-in tokens
FIREBASE_PROJECT_ID=vault-cbf53

# Used only when the super admin email does not already exist. Existing users are never overwritten.
SUPER_ADMIN_EMAIL=ajay@gmail.com
SUPER_ADMIN_PASSWORD=change-this-before-first-boot
